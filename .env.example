# paperless-local-ai deployment settings
#
# Deliberate split:
# - This file contains only values Docker needs before the app can start,
#   plus the Paperless API token because it is a secret.
# - Runtime behavior, Paperless/Ollama URLs, workflow tags and OCR settings
#   are configured centrally in Prompt Studio -> App-Einstellungen.
# - Prompt/model settings remain inside their owning stages
#   (Klassifizierung / Korrespondent-Vorschlag).

# REQUIRED SECRET
# Create/regenerate a token in Paperless -> My Profile.
PAPERLESS_TOKEN=replace-with-paperless-api-token

# Upstream GHCR prefix. Change only when using a fork or another registry.
IMAGE_PREFIX=ghcr.io/lucaperl/paperless-local-ai

# stable follows the newest non-prerelease release.
# Pin e.g. 0.1.0 for a deployment that never moves until you change it.
APP_VERSION=stable

# One persistent app directory. The app owns config/core/ocr/coordination below it.
APP_DATA_DIR=./data

# Host exposure.
# Prompt Studio has no built-in authentication, so localhost is the safe default.
PROMPT_UI_BIND=127.0.0.1
PROMPT_UI_PORT=30148

# The bridge must be reachable from Paperless when native correspondent review is used.
# Keep localhost unless you need the feature, then set a trusted LAN/host address.
SUGGESTION_BRIDGE_BIND=127.0.0.1
SUGGESTION_BRIDGE_PORT=30149

# Docker resource limits. Docker needs these before application processes start.
OCR_CPU_LIMIT=2.0
OCR_MEMORY_LIMIT=6g
OCR_SHM_SIZE=2gb
METADATA_CPU_LIMIT=0.5
METADATA_MEMORY_LIMIT=512m
PROMPT_UI_CPU_LIMIT=0.25
PROMPT_UI_MEMORY_LIMIT=256m
BRIDGE_CPU_LIMIT=0.1
BRIDGE_MEMORY_LIMIT=128m
