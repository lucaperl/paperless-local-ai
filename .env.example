# paperless-local-ai deployment settings
#
# Runtime behavior, Paperless/Ollama URLs, workflow tags and OCR language/model
# are configured centrally in the Control Center. This file only contains
# secrets and values Docker needs before containers can start.

# REQUIRED SECRET: Paperless API token for metadata/review integration.
PAPERLESS_TOKEN=replace-with-paperless-api-token

# REQUIRED SECRET: shared only by Paperless' OCRmyPDF bridge and the local OCR service.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OCR_SERVICE_TOKEN=replace-with-random-ocr-service-token

IMAGE_PREFIX=ghcr.io/lucaperl/paperless-local-ai
APP_VERSION=stable
APP_DATA_DIR=./data

PROMPT_UI_BIND=127.0.0.1
PROMPT_UI_PORT=30148

SUGGESTION_BRIDGE_BIND=127.0.0.1
SUGGESTION_BRIDGE_PORT=30149

# Must be reachable by the Paperless container when OCR integration is enabled.
OCR_SERVICE_BIND=127.0.0.1
OCR_SERVICE_PORT=30150

OCR_PAGE_TIMEOUT_SECONDS=1800
OCR_MAX_REQUEST_BYTES=104857600
OCR_TMP_DIR=/dev/shm/paperless-local-ai-ocr

OCR_SHM_SIZE=2gb
METADATA_CPU_LIMIT=0.5
METADATA_MEMORY_LIMIT=512m
PROMPT_UI_CPU_LIMIT=0.25
PROMPT_UI_MEMORY_LIMIT=256m
BRIDGE_CPU_LIMIT=0.1
BRIDGE_MEMORY_LIMIT=128m

# OCR runtime / PP-OCRv6 Medium
OCR_ENABLE_HPI=true
PADDLE_PDX_CPU_NUM_THREADS=4
OCR_SESSION_IDLE_SECONDS=5
OCR_CPU_LIMIT=4.0
OCR_MEMORY_LIMIT=7g
