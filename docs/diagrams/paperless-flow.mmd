flowchart TB
    A["Paperless import"] --> B{"OCR needed?"}

    B -->|No| N["Use existing PDF text"]
    B -->|Yes| O["PaddleOCR · PP-OCRv6<br/>Medium / Small / Tiny · HPI / OpenVINO"]

    N --> P["Searchable document in Paperless"]
    O --> P

    P --> D["Automatic metadata classification<br/>one LLM request per document<br/><br/>title · document type · date · tags · correspondent"]

    D --> C{"Existing correspondent matched?"}

    C -->|Yes| W["Write metadata to Paperless"]
    C -->|No| E{"Correspondent fallback enabled?"}

    E -->|No| W
    E -->|Yes| F["Correspondent-only LLM request"]

    F -->|Existing or no reliable correspondent| W
    F -->|New correspondent| S["Paperless Suggestions"]

    W --> R["Human review in Paperless"]
    S --> R

    classDef paperless fill:#eef5ff,stroke:#4c78a8,color:#111;
    classDef local fill:#e9f9f1,stroke:#238763,color:#111;
    classDef fallback fill:#f5edff,stroke:#7b55a1,color:#111;

    class A,B,N,P,W,R paperless;
    class O,D,C local;
    class E,F,S fallback;
